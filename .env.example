DISCORD_TOKEN=your-discord-bot-token

# API de control del servidor (salidas de Terraform: server_api_url y server_api_key)
SERVER_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/v1
SERVER_API_KEY=your-api-key

# IDs de roles de Discord (separados por coma) que pueden usar /startserver y /stopserver.
# Los administradores del servidor de Discord siempre pueden.
ADMIN_ROLE_IDS=
